# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#
# Nothing in this file is required for Phase 0/1 (repo scaffolding, strategy engine) —
# these variables are consumed starting at Phase 6+ (data cache / broker adapter / live runner).
# Documented now so the full configuration surface is visible up front (see plan §2.9).

# --- IB Gateway / TWS connection (Phase 6+) ---
# Paper Gateway defaults to 4002, live Gateway to 4001 (TWS: 7497 paper / 7496 live).
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1

# --- Mode selection (Phase 7+) ---
# backtest | paper | live — no default in code for "live"; must be explicit.
TRADING_MODE=backtest

# --- Live-trading safety (Phase 9+) ---
# Live mode refuses to start unless BOTH of these are set explicitly — see SafetyGuard pre-flight
# checklist in the plan (§2.7). Never set these unless you intend to place real orders.
# LIVE_TRADING_CONFIRMED=
# IB_EXPECTED_ACCOUNT_ID=
# EXPECTED_ACCOUNT_VALUE_MIN=
# EXPECTED_ACCOUNT_VALUE_MAX=
# MAX_DAILY_LOSS=
# MAX_PORTFOLIO_EXPOSURE=
# MAX_OPEN_POSITIONS=
# KILL_SWITCH_FILE=

# --- Local dashboard (Phase 5) ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
